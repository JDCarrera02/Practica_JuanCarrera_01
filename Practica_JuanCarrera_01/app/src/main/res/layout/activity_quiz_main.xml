<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".QuizMain">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra_encabezado"
        app:title="@string/titulo_app"
        app:titleTextColor="@color/blanco_personalizado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_personalizado"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <LinearLayout
        android:id="@+id/contenedor_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gris_claro"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/texto_progreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/verde_personalizado"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="1 / 3" />

        <ProgressBar
            android:id="@+id/barra_progreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:max="3"
            android:progressTint="@color/verde_personalizado"
            tools:progress="1" />

        <TextView
            android:id="@+id/enunciado_pregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_pregunta"
            android:gravity="center"
            android:padding="24dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            tools:text="¿Cuál es el verdadero nombre de Batman?" />

        <RadioGroup
            android:id="@+id/respuestas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <RadioButton
                android:id="@+id/opcion_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_opcion"
                android:padding="16dp"
                android:textColorLink="@color/black"
                android:textSize="18sp"
                android:textColor="@color/black"
                tools:text="Opcion A" />

            <RadioButton
                android:id="@+id/opcion_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_opcion"
                android:padding="16dp"
                android:textColorLink="@color/black"
                android:textColor="@color/black"
                android:textSize="18sp"
                tools:text="Opcion B" />

        </RadioGroup>

        <View
            android:id="@+id/vista_vacia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/boton_enviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/verde_personalizado"
            android:text="@string/texto_boton_enviar"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</LinearLayout>